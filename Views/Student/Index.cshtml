@{
    Layout = "_Layout";
}
@model IEnumerable<SchoolApp.Models.Student>

<h2>បញ្ជីរាយនាមនិស្សិត (Traditional Razor View)</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>អត្តលេខ (ID)</th>
            <th>ឈ្មោះពេញ (Full Name)</th>
            <th>ភេទ (Gender)</th>
            <th>មធ្យមភាគ (GPA)</th>
        </tr>
    </thead>
    <tbody>
        @* ២. ប្រើប្រាស់ C# Loop រៀបចំជួរតារាងលើ Server *@
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Gender</td>
                <td>@item.GPA.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Create" class="btn btn-success">
    <i class="fa-solid fa-user-plus me-1"></i> បន្ថែមនិស្សិតថ្មី
</a>